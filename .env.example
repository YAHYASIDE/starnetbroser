# Copy to .env and fill in real values. NEVER commit the real .env file -
# it is already in .gitignore. See docs/DEPLOYMENT.md "Secrets management"
# for how to generate/store these on a real VPS (a secret manager/KMS is
# strongly preferred over a plain file for JWT_SECRET and VAULT_KEY).

# --- Postgres ---
POSTGRES_DB=starnet
POSTGRES_USER=starnet
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_value

# --- Auth / crypto ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=CHANGE_ME_generate_a_fernet_key

# --- Feature flags ---
# Cloud browser session storage (Playwright persistent profiles kept on the
# server). Compliance requirement: this MUST stay "false" in production
# until you have written authorization to store encrypted Starlink browser
# sessions server-side. Safe to set "true" in a local/dev environment with
# authorized test accounts only.
FEATURE_CLOUD_SESSIONS=false

# --- Browser worker orchestration ---
MAX_CONCURRENT_WORKERS=4
WORKER_IDLE_TIMEOUT_SECONDS=300

# --- CORS ---
# JSON array of allowed origins for the Android app / any web admin UI.
CORS_ALLOW_ORIGINS=["*"]
