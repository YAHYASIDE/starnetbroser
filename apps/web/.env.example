# Copy to .env.local for local development.
# Leave NEXT_PUBLIC_DATA_SOURCE unset (or "demo") to run against the safe
# demo data - this is what the public GitHub Pages preview always uses.
# Set it to "api" once apps/web is wired to services/api (a later stage).
NEXT_PUBLIC_DATA_SOURCE=demo
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Injected automatically by CI at build time - do not set locally.
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_BUILD_TIME=
