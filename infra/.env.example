# Copy to infra/.env and fill in real values. Never commit the real file.

# The two domains you point at this VPS - see docs/DEPLOYMENT.md.
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com

POSTGRES_USER=starnet
POSTGRES_PASSWORD=CHANGE_ME_long_random_value
POSTGRES_DB=starnet

JWT_SECRET=CHANGE_ME_generate_a_long_random_value
VAULT_KEY=CHANGE_ME_32_byte_base64_key_for_aes_256_gcm
WORKER_INTERNAL_TOKEN=CHANGE_ME_generate_a_long_random_value

# Stays false until cloud sessions are authorized in writing - see
# docs/ARCHITECTURE.md.
FEATURE_CLOUD_SESSIONS=false

MAX_CONCURRENT_WORKERS=4
WORKER_IDLE_TIMEOUT_SECONDS=300

# Must match `docker info --format '{{.DockerRootDir}}'` on this VPS.
DOCKER_DATA_ROOT=/var/lib/docker
