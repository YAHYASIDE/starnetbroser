<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom bar button of the device/mail browser: a rounded touch ripple on the dark bar. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#332F80FF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
