<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/starnet_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0B1220"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:titleTextColor="#FFFFFF" />

    <ProgressBar
        android:id="@+id/starnet_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/starnet_webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/starnet_error_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="#FFFFFF"
            android:visibility="gone">

            <TextView
                android:id="@+id/starnet_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/starnet_load_error"
                android:textAlignment="center"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/starnet_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/starnet_retry" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/starnet_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#F1F1F1">

        <Button
            android:id="@+id/starnet_btn_back"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/starnet_action_back" />

        <Button
            android:id="@+id/starnet_btn_refresh"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/starnet_action_refresh" />

        <Button
            android:id="@+id/starnet_btn_home"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/starnet_action_home" />

        <Button
            android:id="@+id/starnet_btn_close"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/starnet_action_close" />

        <Button
            android:id="@+id/starnet_btn_sync"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:text="@string/starnet_action_sync" />
    </LinearLayout>
</LinearLayout>
