{
  "name": "@starnet/local-browser-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor plugin: opens each Starlink account in its own isolated native Android WebView profile (AndroidX WebKit Multi-Profile API). No cloud/API involvement - purely on-device session isolation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/"
  ],
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundleWebExtractor.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "6.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
