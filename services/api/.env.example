# Copy to .env for local development. Never commit the real .env - already
# gitignored. See docs/DEPLOYMENT.md for production secrets management.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starnet_dev
REDIS_URL=redis://localhost:6379

JWT_SECRET=CHANGE_ME_generate_a_long_random_value
VAULT_KEY=CHANGE_ME_32_byte_base64_key_for_aes_256_gcm

FEATURE_CLOUD_SESSIONS=false

DOCKER_HOST=
WORKER_IMAGE=starnet-browser-worker:dev
WORKER_NETWORK=starnet_internal
MAX_CONCURRENT_WORKERS=4
WORKER_IDLE_TIMEOUT_SECONDS=300

LOGIN_RATE_LIMIT_PER_MINUTE=10
CORS_ALLOW_ORIGINS=*

PORT=8000
