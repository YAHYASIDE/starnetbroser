# Copy to .env for local development. Never commit the real .env - already
# gitignored. See docs/DEPLOYMENT.md for production secrets management.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/starnet_dev
REDIS_URL=redis://localhost:6379

JWT_SECRET=CHANGE_ME_generate_a_long_random_value
VAULT_KEY=CHANGE_ME_32_byte_base64_key_for_aes_256_gcm

FEATURE_CLOUD_SESSIONS=false

# services/browser-worker's internal-only address - never the public
# internet; see infra/docker-compose.yml for the internal network.
WORKER_INTERNAL_URL=http://localhost:7500
WORKER_INTERNAL_TOKEN=CHANGE_ME_generate_a_long_random_value
VNC_TICKET_TTL_SECONDS=60

LOGIN_RATE_LIMIT_PER_MINUTE=10
CORS_ALLOW_ORIGINS=*

PORT=8000
