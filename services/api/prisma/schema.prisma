// STAR NET data model.
//
// Deliberately NOT one giant table: Customer and StarlinkAccount are
// separate from day one (a Customer owns N StarlinkAccounts), auth tables
// (User/Device/RefreshToken) are separate from both, and BrowserSession /
// AuditLog are their own tables too - see docs/ARCHITECTURE.md "Domain
// model, built for accounting later without a rebuild" for why. This is
// what lets a future `Invoice`/`Payment`/`Currency` set of tables get
// added later purely additively.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A STAR NET operator's own management-account login - NOT a Starlink account.
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String    @map("password_hash")
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  totpEnabled         Boolean   @default(false) @map("totp_enabled")
  createdAt           DateTime  @default(now()) @map("created_at")

  devices   Device[]
  customers Customer[]

  @@map("users")
}

model Device {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String    @default("جهاز غير مسمى")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("devices")
}

/// Rotating refresh tokens - only the SHA-256 hash is ever stored. See
/// services/api/src/auth/auth.service.ts for rotation + reuse detection.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  deviceId      String    @map("device_id")
  tokenHash     String    @unique @map("token_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  expiresAt     DateTime  @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  replacedById  String?   @map("replaced_by_id")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

/// A billing-capable entity that can own more than one StarlinkAccount.
model Customer {
  id          String   @id @default(uuid())
  ownerUserId String   @map("owner_user_id")
  name        String
  notes       String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner    User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  accounts StarlinkAccount[]

  @@index([ownerUserId])
  @@map("customers")
}

model StarlinkAccount {
  id         String @id @default(uuid())
  customerId String @map("customer_id")

  name              String @default("")
  email             String @default("")
  emailSecretEnc    String @default("") @map("email_secret_encrypted")
  wifiCodeEnc       String @default("") @map("wifi_code_encrypted")
  notesEnc          String @default("") @map("notes_encrypted")

  kitNumber      String @default("") @map("kit_number")
  serialNumber   String @default("") @map("serial_number")
  accountNumber  String @default("") @map("account_number")
  subscriptionId String @default("") @map("subscription_id")
  starlinkId     String @default("") @map("starlink_id")
  deviceName     String @default("") @map("device_name")

  rechargeDate String @default("") @map("recharge_date")
  standbyDate  String @default("") @map("standby_date")

  balanceDue String @default("") @map("balance_due")
  currency   String @default("$")
  dishStatus String @default("UNKNOWN") @map("dish_status")
  wifiStatus String @default("UNKNOWN") @map("wifi_status")

  alertReason      String  @default("") @map("alert_reason")
  planName         String  @default("") @map("plan_name")
  serviceStatus    String  @default("") @map("service_status")
  serviceLocation  String  @default("") @map("service_location")
  billingPeriod    String  @default("") @map("billing_period")
  paymentDueDate   String  @default("") @map("payment_due_date")
  softwareVersion  String  @default("") @map("software_version")
  uptime           String  @default("") @map("uptime")

  lastUpdated           String    @default("") @map("last_updated")
  lastSuccessfulScanAt  DateTime? @map("last_successful_scan_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  browserSession BrowserSession?

  @@index([customerId])
  @@map("starlink_accounts")
}

/// The cloud browser worker state for exactly one StarlinkAccount. See
/// services/api/src/browser/browser.service.ts for the lock/concurrency
/// mechanics this backs.
model BrowserSession {
  id                    String    @id @default(uuid())
  accountId             String    @unique @map("account_id")
  profileVolumeName     String    @unique @map("profile_volume_name")
  status                String    @default("STOPPED")
  containerId           String?   @map("container_id")
  containerName         String?   @map("container_name")
  vncTicketHash         String?   @map("vnc_ticket_hash")
  vncTicketExpiresAt    DateTime? @map("vnc_ticket_expires_at")
  lockedAt              DateTime? @map("locked_at")
  lockedByRequestId     String?   @map("locked_by_request_id")
  lastStartedAt         DateTime? @map("last_started_at")
  lastStoppedAt         DateTime? @map("last_stopped_at")
  lastActivityAt        DateTime? @map("last_activity_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  account StarlinkAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("browser_sessions")
}

/// Security log: logins, device revocations, account opens/scans. `detail`
/// is built only from non-secret fields - see
/// services/api/src/audit/audit.service.ts, the single writer.
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  deviceId  String?  @map("device_id")
  accountId String?  @map("account_id")
  action    String
  detail    String   @default("")
  ipAddress String   @default("") @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("audit_log")
}
