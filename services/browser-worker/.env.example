# Copy to .env for local development. Never commit the real .env.

PORT=7500

# Shared secret with services/api - never reachable from outside the
# internal Docker network in production; this is defense in depth.
WORKER_INTERNAL_TOKEN=CHANGE_ME_generate_a_long_random_value

# In this sandbox: /opt/pw-browsers/chromium. In the Docker image
# (see Dockerfile): /usr/bin/chromium (installed via apt).
CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium

PROFILE_VOLUME_PREFIX=starnet_profile_
MAX_CONCURRENT_WORKERS=4
WORKER_IDLE_TIMEOUT_SECONDS=300
VNC_DISPLAY_BASE=100
SESSION_VIEWPORT_WIDTH=1280
SESSION_VIEWPORT_HEIGHT=800
